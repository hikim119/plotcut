# 저작물 — 영화 파일과 자막은 절대 올리지 않는다 (영화 한 편이 수 GB)
test/

# 결과물 — 만든 대본·CapCut 상태
results/

# 대본 생성 중간 파일
.work/

# 내 완성 대본 원고 (영화 대사가 섞여 있다)
# 대본예시 — **완성본 3개는 올린다.** 대본 생성 프롬프트가 「대사와 나레이션이
# 어떤 리듬으로 섞이는지 여기서 배운다」며 이 파일들을 가리키는데, 없으면
# 그 지시가 통째로 빠진다(폴더가 없으면 조건 분기로 사라진다).
# 이미 유튜브에 공개된 숏츠의 자막이고, 나레이션은 저자 본인 글이다.
#
# **`원본자막/` 은 안 올린다** — 번역 전 영어 영화 자막 271KB 다.
# 완성본이 아니고, 프롬프트도 「읽지 마라」고 시킨다.
대본예시/원본자막/

# 로컬 설정 — 사람마다 다르다
runner.json
PlotCut.lnk

# 파이썬
__pycache__/
*.py[cod]

# 이전 설계의 잔해
_old/

# 실험 데이터 (대본 배치·대결) — 저작권 자막에서 나온 것이라 공개 안 한다
results/_bench/
